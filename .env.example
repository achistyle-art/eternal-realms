# Vorlage für den Alpha-Server mit Docker: nach .env kopieren und ausfüllen (.env wird nicht eingecheckt).
#   cp .env.example .env

# Datenbankpasswort – bitte ein eigenes, zufälliges wählen, z. B.: openssl rand -base64 24
ER_DB_PASSWORD=HIER-EIN-EIGENES-PASSWORT

# true = neue Konten nur mit Einladungscode (geschlossene Alpha)
ER_INVITE_ONLY=true

# ki = mit gekennzeichneten KI-Mitspielern, klassisch = nur Menschen
ER_MODE=ki

# Begrüßung nach dem Betreten der Welt; \n trennt Zeilen
ER_MOTD=Willkommen zur Alpha von Eternal Realms!\nFehler bitte mit /bug melden – danke!

# Öffentlicher UDP-Port des Servers
ER_PUBLIC_PORT=7777
