<!--
  Qualitätssicherung (Kapitel 57): kompiliert die Unity-Skripte ohne Unity-Editor gegen die Unity-2021.3-Module
  und dieselbe Sprachversion (C# 9, netstandard2.1). Findet Kompilierfehler, ersetzt aber keinen Test im Editor.
    dotnet build tools/UnityCheck
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS8618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../client/Unity/Assets/EternalRealms/Scripts/*.cs" />
    <ProjectReference Include="../../src/EternalRealms.Shared/EternalRealms.Shared.csproj" />
  </ItemGroup>
  <!-- Standard (CI): Referenzassemblys von Unity 2021.3 aus NuGet. -->
  <ItemGroup Condition="'$(UnityManaged)' == ''">
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
  </ItemGroup>
  <!--
    Genauer: gegen einen echten Unity-6-Editor, inklusive der Editor-Skripte (Menü, Alpha-Build).
      dotnet build tools/UnityCheck -p:UnityManaged=<Unity>/Editor/Data/Managed
    Der Ordner enthält UnityEngine/ (Module) – mehr braucht es nicht, eine Lizenz ist dafür nicht nötig.
  -->
  <ItemGroup Condition="'$(UnityManaged)' != ''">
    <Compile Include="../../client/Unity/Assets/EternalRealms/Editor/*.cs" />
    <Reference Include="$(UnityManaged)/UnityEngine/UnityEngine.*.dll" Private="false" />
    <Reference Include="$(UnityManaged)/UnityEngine/UnityEditor.*.dll" Private="false" />
  </ItemGroup>
</Project>
